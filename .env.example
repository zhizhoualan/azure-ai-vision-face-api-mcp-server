# MCP Bridge Configuration
MCP_COMMAND=uvx
MCP_ARGS=--from git+https://github.com/Azure-Samples/azure-ai-vision-face-api-mcp-server azure-face-mcp
MCP_CWD=..

# Azure Face API Configuration (Required)
# Get these from Azure Portal: https://portal.azure.com/#create/Microsoft.CognitiveServicesFace
AZURE_FACE_ENDPOINT=
AZURE_FACE_API_KEY=

# Azure OpenAI Configuration (Optional - for open-set attribute detection)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Azure Storage Configuration (Optional - for image management)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_SAS_TOKEN=

# Note: Fill in the values above to run integration tests (test_prompt_live_*.py)
# Unit tests (test_prompt_parser.py) don't require any credentials